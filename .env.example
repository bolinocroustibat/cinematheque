## Global (backend + frontend)
ENVIRONMENT=local
DEBUG=false # DEBUG should be set to "false" for production
PUBLIC_SENTRY_DSN=your_sentry_dsn_here

## Ports
API_PORT=8000
FRONTEND_PALETTES_PORT=3001
POSTGRES_PORT=5432

## Backend
DJANGO_SECRET_KEY=your_django_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# CORS: browser Origin allowed to call the API (use the Palettes app URL; port should match FRONTEND_PALETTES_PORT)
CORS_ORIGIN_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Shared secret for POST create endpoints (header: X-API-Key). Leave empty to reject all writes.
API_WRITE_KEY=
# CSRF trusted origins for admin login (HTTPS). Falls back to CORS_ALLOWED_ORIGINS if unset.
# CSRF_TRUSTED_ORIGINS=https://cinematheque.adriencarpentier.com
# Movie recommendations LLM (e.g. Gemini)
LLM_API_KEY=
# Poster resolution (backend TMDB search + OMDb fallback for movies; server-side only)
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# https://www.omdbapi.com/apikey.aspx (optional fallback when TMDB has no poster)
OMDB_API_KEY=

# Local Google Drive mount (sync_local_drive). Trailing slash optional.
# macOS example:
# DRIVE_BASE_PATH=/Users/you/Library/CloudStorage/GoogleDrive-you@example.com/My Drive
# Colab example:
# DRIVE_BASE_PATH=/content/drive/MyDrive
DRIVE_BASE_PATH=
# Optional: local IMDb dataset for sync_local_drive (Cinemagoer S3 access).
# Import with: s32cinemagoer.py /path/to/imdb-tsv/ sqlite:///cinemagoer.db
# CINEMAGOER_DB_URI=sqlite:///cinemagoer.db

## Database
POSTGRES_DB=cinematheque_django

## Frontend-palettes
# Backend base URL: optional; if unset, Palettes uses http://localhost:<API_PORT>
# (server load + API proxy via $env/dynamic/private at runtime)
# docker-compose sets API_URL=http://backend:8000 for the frontend service.
# API_URL=http://localhost:8000
