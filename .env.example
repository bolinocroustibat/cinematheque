## Global (backend + both frontends)
ENVIRONMENT=local

## Ports
API_PORT=8000
APP_PORT=3000
MOVIES_PALETTES_PORT=3001

## Backend
DJANGO_SECRET_KEY=your_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# CORS: browser Origin allowed to call the API (use the Cinematheque app URL; port should match APP_PORT)
CORS_ORIGIN_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_DB=cinematheque_django
# DB host: 127.0.0.1 when Postgres is published on the host (e.g. `docker compose up db`).
# The `backend` service in docker-compose.yaml forces POSTGRES_HOST=db inside the container.
# Django does not load this file; use direnv, export vars in your shell, or docker compose.
POSTGRES_HOST=127.0.0.1
PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Movie recommendations LLM (e.g. Gemini)
LLM_API_KEY=

# Poster resolution (backend TMDB search + OMDb fallback for movies; server-side only)
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# https://www.omdbapi.com/apikey.aspx (optional fallback when TMDB has no poster)
OMDB_API_KEY=

## Frontends
# Backend base URL: optional; if unset, both use http://localhost:<API_PORT>
# (Cinematheque + Palettes: server load + API proxy via $env/dynamic/private at runtime)
# docker-compose sets API_URL=http://backend:8000 for both frontend services.
# API_URL=http://localhost:8000
# Client-side TMDB/OMDB (Cinematheque add/fix poster modals) — build-time Vite define
# VITE_TMDB_KEY=
# VITE_OMDB_KEY=
