# Global settings
ENVIRONMENT=local
API_PORT=8000
FRONTEND_PORT=4173

## Backend settings
# Django core settings
DJANGO_SECRET_KEY=your_django_secret_key_here
DEBUG=False

# Security settings
# ALLOWED_HOSTS: domains Django will serve (validates Host header)
# CORS_ALLOWED_ORIGINS: domains allowed for browser requests (validates Origin header)
ALLOWED_HOSTS=
CORS_ORIGIN_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=http://localhost:4173

# Database settings
POSTGRES_DB=cinematheque_django

# TMDB API Key
# Get your API key from https://www.themoviedb.org/settings/api
VITE_TMDB_KEY=your_tmdb_api_key_here

# OMDb API Key (fallback for movie posters)
# Get your API key from https://www.omdbapi.com/apikey.aspx
VITE_OMDB_KEY=your_omdb_api_key_here

# Google Sheets API URL
# Your Google Apps Script Web App URL
VITE_SHEETS_API=your_google_sheets_api_url_here

# TMDB Image URLs (optional, defaults provided)
